# ─── Data source ──────────────────────────────────────────────────────────────
# "monday" (default) queries the live boards. "mock" uses the local fixture
# built by `npm run seed` — for local development before the boards exist.
DATA_SOURCE=monday

# ─── Monday.com ───────────────────────────────────────────────────────────────
# Personal API v2 token: monday.com → avatar → Developers → My access tokens
MONDAY_API_KEY=
# Board IDs are the numbers in the board URL: monday.com/boards/<BOARD_ID>
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Free keys, no card required: https://console.groq.com
#
# GROQ_API_KEYS accepts several comma-separated keys. When one trips Groq's
# per-minute or per-day limit the request is retried on the next key
# automatically, and the exhausted key is benched for a matching cooldown.
# A single GROQ_API_KEY also works and is treated as a pool of one.
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── Tuning ───────────────────────────────────────────────────────────────────
# How long a fetched dataset is reused across tool calls, in milliseconds.
# Keeps one conversational turn from re-paginating both boards several times.
DATA_CACHE_TTL_MS=60000
